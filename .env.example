# ==========================================
# SmartChat AI - Environment Configuration
# ==========================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartchat-ai-super-secret-key-2026

# AI Provider API Keys (Fill at least one to activate live AI generation)
# 1. Google Gemini API (Recommended & Free): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq API (High speed, Free tier): https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI API: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. OpenRouter API: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
